---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Project } from '../../lib/site-config';

interface Props {
  project: Project;
  image: ImageMetadata;
  alt: string;
}

const { project, image, alt } = Astro.props;
---

<article class="overflow-hidden rounded-xl border border-border bg-surface-alt">
  <a href={project.href} target="_blank" rel="noopener noreferrer" class="group block">
    <Image
      src={image}
      alt={alt}
      class="w-full transition-[scale] duration-500 ease-out group-hover:scale-[1.02]"
    />
  </a>
  <div class="p-5">
    <h3 class="font-medium">
      <a
        href={project.href}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-sm hover:text-accent"
      >
        {project.title}
      </a>
    </h3>
    <p class="mt-2 text-sm leading-relaxed text-content-muted">{project.description}</p>
  </div>
</article>
