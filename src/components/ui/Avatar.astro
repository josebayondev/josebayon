---
import { Image } from 'astro:assets';
// Importado explicitamente aunque sea un tipo global: si no, `no-undef` lo marca.
import type { ImageMetadata } from 'astro';

interface Props {
  alt: string;
  /** Iniciales del placeholder mientras no haya foto real. */
  initials: string;
  /** Importa la foto desde `src/assets/` y pasala aqui para sustituir el placeholder. */
  src?: ImageMetadata;
  class?: string;
}

const { alt, initials, src, class: className } = Astro.props;
---

<div class:list={['avatar', className]}>
  {
    src ? (
      <Image src={src} alt={alt} width={112} height={112} loading="eager" class="avatar__img" />
    ) : (
      <div class="avatar__img avatar__placeholder" role="img" aria-label={alt}>
        <span aria-hidden="true">{initials}</span>
      </div>
    )
  }
</div>

<style>
  .avatar {
    /* El contenedor recorta y el hijo escala: asi el zoom no desborda el circulo. */
    width: 7rem;
    height: 7rem;
    overflow: hidden;
    border-radius: 9999px;
    border: 1px solid var(--color-border);
    /* Ligero desenfado en reposo, para que enderezarse al pasar el raton se note. */
    rotate: -2deg;
    transition:
      rotate 300ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 300ms ease;
  }

  .avatar__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.4);
    transition:
      scale 300ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 300ms ease;
  }

  .avatar__placeholder {
    display: grid;
    place-items: center;
    background-color: var(--color-surface-alt);
    color: var(--color-content-muted);
    font-size: 1.75rem;
    font-weight: 500;
    letter-spacing: 0.05em;
  }

  .avatar:hover {
    rotate: 0deg;
    border-color: var(--color-accent);
  }

  .avatar:hover .avatar__img {
    scale: 1.06;
    filter: grayscale(0);
  }
</style>
