---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import CityscapeArt from './CityscapeArt.astro';

/**
 * Panel visual de la columna derecha.
 *
 * Sin `src` dibuja la ilustracion vectorial, que solo se anima al pasar el raton.
 * Para poner una imagen propia, importala desde `src/assets/` y pasala en `src`.
 */
interface Props {
  src?: ImageMetadata;
  alt?: string;
  class?: string;
}

const { src, alt = '', class: className } = Astro.props;
---

<figure class:list={['showcase', className]}>
  {src ? <Image src={src} alt={alt} class="showcase__img" loading="eager" /> : <CityscapeArt />}
</figure>

<style>
  .showcase {
    position: relative;
    overflow: hidden;
    height: 100%;
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    background-color: var(--color-surface-alt);
    transition: border-color 400ms ease;
  }

  .showcase:hover {
    border-color: var(--color-accent);
  }

  .showcase__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .showcase:hover .showcase__img {
    scale: 1.04;
  }
</style>
