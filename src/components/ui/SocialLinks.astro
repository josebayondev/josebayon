---
import type { SocialLink } from '../../lib/site-config';

interface Props {
  links: readonly SocialLink[];
  class?: string;
}

const { links, class: className } = Astro.props;
---

<ul class:list={['flex flex-wrap items-center gap-x-4 gap-y-1', className]}>
  {
    links.map((link) => (
      <li>
        <a
          href={link.href}
          class="rounded-sm text-sm text-content-muted transition-colors hover:text-accent"
          {...(link.href.startsWith('http')
            ? { target: '_blank', rel: 'noopener noreferrer' }
            : {})}
        >
          {link.label}
        </a>
      </li>
    ))
  }
</ul>
