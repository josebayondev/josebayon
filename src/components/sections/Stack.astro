---
import { siteConfig } from '../../lib/site-config';
---

<section class="mt-16">
  <h2 class="font-mono text-xs tracking-wider text-content-muted uppercase">Con qué trabajo</h2>

  <dl class="mt-6 space-y-6">
    {
      siteConfig.stack.map((group) => (
        <div class="flex flex-col gap-2 sm:flex-row sm:gap-6">
          <dt class="pt-1 text-sm text-content-muted sm:w-24 sm:shrink-0">{group.title}</dt>
          <dd class="flex flex-wrap gap-2">
            {group.items.map((item) => (
              <span class="rounded-md border border-border bg-surface-alt px-2 py-1 font-mono text-xs">
                {item}
              </span>
            ))}
          </dd>
        </div>
      ))
    }
  </dl>
</section>
