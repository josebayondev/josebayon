---
/**
 * El tema ya viene puesto en <html data-theme> por el script inline de
 * BaseLayout. Aqui solo se alterna y se recuerda la eleccion.
 *
 * Los dos iconos van siempre en el DOM y se muestran con la variante `dark:`:
 * cambiarlos por CSS evita que el boton parpadee con el icono equivocado
 * mientras el JS del cliente aun no ha cargado.
 */
---

<button
  type="button"
  data-theme-toggle
  aria-label="Cambiar entre tema claro y oscuro"
  class="grid size-9 place-items-center rounded-full border border-border text-content-muted transition-colors hover:border-accent hover:text-accent"
>
  <svg
    class="size-4 dark:hidden"
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
    focusable="false"
  >
    <mask id="moon-crescent">
      <rect width="24" height="24" fill="white"></rect>
      <circle cx="17.5" cy="8.5" r="8.5" fill="black"></circle>
    </mask>
    <circle cx="12" cy="12" r="9" mask="url(#moon-crescent)"></circle>
  </svg>

  <svg
    class="hidden size-4 dark:block"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    aria-hidden="true"
    focusable="false"
  >
    <circle cx="12" cy="12" r="4.5"></circle>
    <path
      d="M12 1.5v2.5M12 20v2.5M1.5 12h2.5M20 12h2.5M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M19.4 4.6l-1.8 1.8M6.4 17.6l-1.8 1.8"
    ></path>
  </svg>
</button>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

  toggle?.addEventListener('click', () => {
    const next = document.documentElement.dataset['theme'] === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset['theme'] = next;

    try {
      localStorage.setItem('theme', next);
    } catch {
      // Almacenamiento bloqueado: el tema cambia igual, solo que no se recuerda.
    }
  });
</script>
