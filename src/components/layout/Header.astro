---
import SocialLinks from '../ui/SocialLinks.astro';
import ThemeToggle from './ThemeToggle.astro';
import { siteConfig } from '../../lib/site-config';

// El nombre no se repite aqui: el <h1> de la home queda justo debajo y seria
// el mismo texto dos veces seguidas para un lector de pantalla.
---

<header class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 py-6">
  <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
    <nav>
      <a
        href="/proyectos"
        class="rounded-sm text-sm text-content-muted transition-colors hover:text-accent"
      >
        Proyectos
      </a>
    </nav>
    <SocialLinks links={siteConfig.socials} />
  </div>
  <ThemeToggle />
</header>
